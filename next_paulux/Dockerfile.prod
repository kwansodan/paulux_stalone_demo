# ─── Stage 1: deps ───────────────────────────────────────────────────────────
# Full install (dev + prod) so Prisma generation and Next.js build can run.
FROM node:20-alpine AS deps
RUN apk add --no-cache ca-certificates libc6-compat
WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma/

# npm ci installs exactly what package-lock.json specifies.
# postinstall runs `prisma generate` automatically.
RUN npm ci

# ─── Stage 2: builder ────────────────────────────────────────────────────────
# Compiles the Next.js application into a standalone output.
FROM node:20-alpine AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build-time public env vars (baked into the client bundle at compile time).
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY is deliberately NOT here: checkout is a
# server-side redirect flow (api/paystack/initialize -> authorization_url), so
# the public key is never read in the browser. Keeping it a runtime-only var
# means it can be changed in the deployment environment without a rebuild.
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_MINIO_ENDPOINT
ARG NEXT_PUBLIC_MINIO_PORT

ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_MINIO_ENDPOINT=$NEXT_PUBLIC_MINIO_ENDPOINT
ENV NEXT_PUBLIC_MINIO_PORT=$NEXT_PUBLIC_MINIO_PORT
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=2048"

# Generate Prisma client then compile.
# `output: 'standalone'` in next.config.ts produces .next/standalone/ which
# contains a tree-shaken node_modules — the ONLY node_modules the runtime needs.
RUN npx prisma generate && npm run build

# ─── Stage 3: runner ─────────────────────────────────────────────────────────
# Minimal production image. Nothing from the build stages except the compiled
# output and the Prisma schema needed for db push at container startup.
FROM node:20-alpine AS runner
RUN apk add --no-cache ca-certificates
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# ── Next.js standalone output ─────────────────────────────────────────────────
# .next/standalone/ already contains a minimal, tree-shaken node_modules built
# by Next.js. No separate node_modules install is needed for the server itself.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

# ── Prisma files for db push at startup ───────────────────────────────────────
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/generated ./generated
# prisma.config.ts is intentionally NOT copied: it imports 'prisma/config' which
# is unresolvable in /app without a local node_modules. It's unnecessary here
# because the entrypoint passes --schema explicitly.

# ── Prisma CLI + tsx ──────────────────────────────────────────────────────────
# Install as globals so they don't touch the standalone node_modules at all.
# prisma: needed for `npx prisma db push` in the entrypoint.
# tsx:    needed for optional seed scripts (`npm run prisma-seed`).
# Single RUN = single Docker layer.
RUN npm install -g prisma tsx

# ── Permissions ───────────────────────────────────────────────────────────────
RUN mkdir -p .next/cache && chown -R nextjs:nodejs .next/cache

COPY --chmod=755 docker-entrypoint.sh ./

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["./docker-entrypoint.sh"]
