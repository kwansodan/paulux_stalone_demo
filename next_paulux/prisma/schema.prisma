// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
  STAFF
  SUPER_ADMIN
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum SupportedCurrency {
  GHS
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  SALE
  SALE_REVERSAL
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  tokenHash String   @id
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  email        String  @unique
  passwordHash String
  phone        String?

  role UserRole @default(ADMIN)

  // A capability, independent of role: a STAFF member marked isStylist is
  // assignable to bookings and gets the stylist portal. A person can be a
  // stylist AND hold an admin customRole.
  isStylist Boolean @default(false)

  // Deactivated users keep their history but cannot log in, hold a session, or
  // be assigned to bookings. Preferred over deletion, which clears attribution.
  isActive Boolean @default(true)

  customRoleId String? @db.Uuid
  customRole   Role?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  bookings         Booking[]
  assignedBookings Booking[]             @relation("BookingAssignedTo")
  assignedServices BookingService[]      @relation("BookingServiceAssignedTo")
  stockMovements   ProductStockMovement[]
  giftCardRedemptions GiftCardRedemption[]
  materialMovements   MaterialMovement[]

  @@map("users")
}

model ServiceCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  capacity  Int       @default(1)
  services  Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}

model Service {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  price           Decimal           @db.Decimal(10, 2)
  currency        SupportedCurrency @default(GHS)

  categoryId String?          @db.Uuid
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  maxBookingsPerDay Int?
  latestBookingTime String? // "HH:mm"
  minDepositFixed   Decimal  @default(0) @db.Decimal(10, 2)

  isActive  Boolean  @default(true)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings  BookingService[]
  packages  PackageService[]

  @@index([categoryId])
  @@map("services")
}

model ServicePackage {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  description       String?
  imageUrl          String?
  price             Decimal           @db.Decimal(10, 2)
  currency          SupportedCurrency @default(GHS)
  minDepositFixed   Decimal           @default(0) @db.Decimal(10, 2)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  services PackageService[]
  bookings Booking[]

  @@map("packages")
}

model PackageService {
  packageId String         @db.Uuid
  package   ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  serviceId String         @db.Uuid
  service   Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([packageId, serviceId])
  @@map("package_services")
}

enum PaymentProvider {
  PRIMARY_PAYSTACK
  SECONDARY_PAYSTACK
  MANUAL
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum BookingType {
  SCHEDULED
  WALKIN
}

enum GiftCardStatus {
  PENDING_PAYMENT
  ACTIVE
  PARTIALLY_REDEEMED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum GiftCardDeliveryMethod {
  SMS
  EMAIL
  BOTH
}

enum GiftCardItemType {
  SERVICE
  PRODUCT
}

model PromoCode {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)
  maxUses          Int?
  usedCount        Int          @default(0)
  expiresAt        DateTime?
  isActive         Boolean      @default(true)
  minBookingAmount Decimal?     @db.Decimal(10, 2)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  bookings Booking[]

  @@map("promo_codes")
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: Cascade)

  provider    PaymentProvider
  providerRef String // reference from gateway
  amount      Decimal           @db.Decimal(10, 2)
  // Paystack processing fee surcharged to the customer (part of what was charged
  // at the gateway, but NOT credited toward the booking balance). 0 for manual/cash.
  feeAmount   Decimal           @default(0) @db.Decimal(10, 2)
  currency    SupportedCurrency

  status     PaymentStatus
  rawPayload Json?
  reason     String?

  manualMethodId String?              @db.Uuid
  manualMethod   ManualPaymentMethod? @relation(fields: [manualMethodId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([bookingId])
  @@map("payments")
}

model ManualPaymentMethod {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@map("manual_payment_methods")
}

model Booking {
  id               String @id @default(uuid()) @db.Uuid
  bookingReference String @unique
  clientName       String
  clientEmail      String
  clientPhone      String

  // serviceId String  @db.Uuid
  // service   Service @relation(fields: [serviceId], references: [id])
  services  BookingService[]
  products  BookingProduct[]

  minDepositFixed   Decimal? @db.Decimal(10, 2)

  bookingDate String
  bookingTime String

  status        BookingStatus
  // paymentStatus PaymentStatus
  // paymentRef    String?
  paymentStatus PaymentStatus @default(PENDING)
  // payments      Payment[]
  googleEventId String?
  cancelReason  String?

  termsAcceptedAt DateTime?

  feedbackRequestedAt DateTime?

  packageId String?         @db.Uuid
  package   ServicePackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  promoCodeId    String?    @db.Uuid
  promoCode      PromoCode? @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  discountAmount Decimal?   @db.Decimal(10, 2)

  bookingType    BookingType @default(SCHEDULED)

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("BookingAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  createdById String? @db.Uuid
  // Explicit SetNull (Prisma's implicit default for optional relations) so deleting
  // a staff account clears attribution instead of blocking the delete.
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  payments          Payment[]          @relation("BookingPayments")
  invoices          Invoice[]          @relation("BookingInvoices")
  paymentAuditLogs  PaymentAuditLog[]  @relation("BookingPaymentAuditLogs")
  giftCardRedemptions GiftCardRedemption[] @relation("BookingGiftCardRedemptions")
  productStockMovements ProductStockMovement[]

  @@index([createdById])
  @@index([assignedToId])
  @@index([bookingDate])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

model BookingService {
  bookingId String @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id])

  priceAtBooking    Decimal @db.Decimal(10, 2)
  durationAtBooking Int
  quantity          Int     @default(1)

  assignedToId String? @db.Uuid
  assignedTo   User?   @relation("BookingServiceAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@id([bookingId, serviceId])
  @@index([assignedToId])
  @@map("booking_services")
}

model ProductCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  products  Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

model Product {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String?
  price       Decimal           @db.Decimal(10, 2)
  currency    SupportedCurrency @default(GHS)
  isActive    Boolean           @default(true)
  imageUrl    String?

  stockQuantity     Int     @default(0)
  lowStockThreshold Int     @default(5)
  trackStock        Boolean @default(false)

  categoryId String?          @db.Uuid
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings       BookingProduct[]
  stockMovements ProductStockMovement[]

  @@index([categoryId])
  @@map("products")
}

model ProductStockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  productId String            @db.Uuid
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      StockMovementType
  quantity  Int
  notes     String?

  // Set for SALE / SALE_REVERSAL movements — links the movement to the booking
  // whose product sale (or reversal) it represents. Null for manual IN/OUT/ADJUSTMENT.
  bookingId String?  @db.Uuid
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([bookingId])
  @@index([createdAt])
  @@map("product_stock_movements")
}

model BookingProduct {
  bookingId String  @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  priceAtBooking Decimal @db.Decimal(10, 2)
  quantity       Int     @default(1)

  @@id([bookingId, productId])
  @@map("booking_products")
}

model BusinessHour {
  id        String  @id @default(uuid()) @db.Uuid
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String
  endTime   String
  isOpen    Boolean @default(true)

  maxConcurrentBookings Int @default(4) //should be able to be set??phase 2??

  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
  @@map("business_hours")
}

model BlockedDate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  reason    String?
  startTime DateTime? // Add this field
  endTime   DateTime? // Add this field
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("blocked_dates")
}
enum InvoiceStatus {
  DRAFT
  PENDING
  ISSUED
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  bookingId     String        @db.Uuid
  booking       Booking       @relation("BookingInvoices", fields: [bookingId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(10, 2)
  // Processing fee surcharged on top of `amount` when charging the gateway.
  feeAmount     Decimal       @default(0) @db.Decimal(10, 2)
  currency      SupportedCurrency @default(GHS)
  status        InvoiceStatus @default(DRAFT)
  
  gateway       PaymentProvider?
  transactionType String      @default("initial") // e.g., "initial", "refund"
  
  dueDate       DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  
  parentInvoiceId String?    @db.Uuid
  parentInvoice   Invoice?   @relation("InvoiceChildren", fields: [parentInvoiceId], references: [id])
  childInvoices   Invoice[]  @relation("InvoiceChildren")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  auditLogs     PaymentAuditLog[]

  @@index([bookingId])
  @@index([status])
  @@map("invoices")
}

model PaymentAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String?  @db.Uuid
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  
  bookingId  String?  @db.Uuid
  booking    Booking? @relation("BookingPaymentAuditLogs", fields: [bookingId], references: [id])
  
  action     String // e.g., "INVOICE_CREATED", "PAYMENT_RECEIVED", "STATUS_UPDATED"
  oldValue   Json?
  newValue   Json?
  metadata   Json? // For tracking who did it, IP, etc.
  
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@map("payment_audit_logs")
}

model StyleImage {
  id         String   @id @default(uuid()) @db.Uuid
  url        String
  objectName String
  caption    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("style_images")
}

model SystemSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model GiftCard {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique // redemption code shown to recipient, e.g. GFT-XXXXXXXX

  // Sender (purchaser) details
  senderName  String
  senderEmail String
  senderPhone String

  // Recipient details
  recipientName  String
  recipientEmail String?
  recipientPhone String?
  message        String? // personal message from sender to recipient

  deliveryMethod GiftCardDeliveryMethod @default(EMAIL)
  deliveredAt    DateTime?

  totalAmount Decimal           @db.Decimal(10, 2)
  balance     Decimal           @db.Decimal(10, 2)
  // Processing fee the purchaser paid on top of totalAmount (Paystack surcharge).
  feeAmount   Decimal           @default(0) @db.Decimal(10, 2)
  currency    SupportedCurrency @default(GHS)

  status    GiftCardStatus @default(PENDING_PAYMENT)
  expiresAt DateTime?

  // Purchase payment
  paymentStatus   PaymentStatus    @default(PENDING)
  paymentProvider PaymentProvider?
  paymentRef      String?

  items       GiftCardItem[]
  redemptions GiftCardRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentRef])
  @@map("gift_cards")
}

model GiftCardItem {
  id         String   @id @default(uuid()) @db.Uuid
  giftCardId String   @db.Uuid
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  itemType GiftCardItemType
  // Snapshot references — not FK relations, so deleting a service/product later
  // doesn't affect historical gift cards.
  serviceId String? @db.Uuid
  productId String? @db.Uuid

  name      String // snapshot of service/product name
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  @@index([giftCardId])
  @@map("gift_card_items")
}

model GiftCardRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  giftCardId String   @db.Uuid
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)

  bookingId String?  @db.Uuid
  booking   Booking? @relation("BookingGiftCardRedemptions", fields: [bookingId], references: [id], onDelete: SetNull)

  amountApplied Decimal @db.Decimal(10, 2)

  redeemedById String? @db.Uuid
  redeemedBy   User?   @relation(fields: [redeemedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([giftCardId])
  @@index([bookingId])
  @@map("gift_card_redemptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// Materials / consumables — internal supplies issued to business sections
// (Nails, Barber, Hair, …) and tracked for cost accounting. Distinct from
// Product (which is sold). Reuses StockMovementType (IN/OUT/ADJUSTMENT).
// ─────────────────────────────────────────────────────────────────────────────

// A cost centre that consumes materials. Seeded from service categories but
// kept independent so e.g. "Barber" can exist without being a bookable service.
model Section {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  movements MaterialMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

model MaterialCategory {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  materials Material[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("material_categories")
}

model Material {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  description String?
  unit        String // unit of measure: ml, g, pcs, bottle, pack
  unitCost    Decimal           @db.Decimal(10, 2) // current cost per unit
  currency    SupportedCurrency @default(GHS)

  stockQuantity     Decimal @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal @default(0) @db.Decimal(12, 2)
  trackStock        Boolean @default(true)
  isActive          Boolean @default(true)

  categoryId String?           @db.Uuid
  category   MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  movements MaterialMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@map("materials")
}

model MaterialMovement {
  id         String            @id @default(uuid()) @db.Uuid
  materialId String            @db.Uuid
  material   Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type       StockMovementType // IN = restock/purchase, OUT = issued to section, ADJUSTMENT
  quantity   Decimal           @db.Decimal(12, 2)

  // Required for OUT (issuance) movements; null for restock/adjustment.
  sectionId String?  @db.Uuid
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  // Snapshot of unit cost at the moment of the movement, so period cost
  // reports remain accurate even when the material's unitCost changes later.
  unitCostAtMovement Decimal @db.Decimal(10, 2)

  notes       String?
  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([materialId])
  @@index([sectionId])
  @@index([createdAt])
  @@map("material_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Demo lead capture — prospects who request access to the demo environment.
// Not part of the salon domain; this exists only so the demo deployment can
// record who asked to look at it.
// ─────────────────────────────────────────────────────────────────────────────
model DemoLead {
  id   String @id @default(uuid()) @db.Uuid
  name String

  // The mobile number is the lead. Stored normalised (233XXXXXXXXX) so the
  // same person entering 024... or +233... is recognised as one number.
  phone String

  // Optional: a verified mobile is what qualifies a lead here, so nobody is
  // forced to hand over an email to see the demo.
  email    String?
  business String?
  message  String?

  // Access is only granted once the number has been proven via OTP.
  phoneVerified Boolean   @default(false)
  verifiedAt    DateTime?

  // Captured for abuse triage only, never displayed back to anyone.
  userAgent String?

  // Deliberately NOT unique on phone: a prospect coming back is a signal
  // worth keeping, so every request is recorded.
  createdAt DateTime @default(now())

  otps       DemoOtp[]
  activities DemoActivity[]

  @@index([phone])
  @@index([createdAt])
  @@index([phoneVerified])
  @@map("demo_leads")
}

/// Pages a verified prospect looked at inside the demo. Everyone shares one
/// demo login, so sessions cannot tell prospects apart — attribution comes
/// from a signed cookie set at OTP verification, when we know who is present.
model DemoActivity {
  id     String   @id @default(uuid()) @db.Uuid
  leadId String   @db.Uuid
  lead   DemoLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  path      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("demo_activity")
}

/// One-time codes for demo phone verification. Separate from DemoLead so a
/// live secret never sits on the lead record, and so resends leave a trail.
model DemoOtp {
  id     String   @id @default(uuid()) @db.Uuid
  leadId String   @db.Uuid
  lead   DemoLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Normalised, duplicated from the lead so per-number throttling can be
  // answered without a join.
  phone String

  // bcrypt, never the code itself — the same treatment user passwords get.
  codeHash  String
  expiresAt DateTime

  // Guessing budget. Exhausting it burns the code rather than the number.
  attempts   Int       @default(0)
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([phone, createdAt])
  @@map("demo_otps")
}