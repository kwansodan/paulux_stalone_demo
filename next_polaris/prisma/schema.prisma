// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CUSTOMER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum SupportedCurrency {
  GHS
}

model Session {
  id        String   @id
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  tokenHash String   @id
  expiresAt DateTime
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id           String  @id @default(uuid()) @db.Uuid
  username     String  @unique
  email        String  @unique
  passwordHash String
  phone        String?

  role UserRole @default(ADMIN)

  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  bookings Booking[]

  @@map("users")
}

model ServiceCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  capacity  Int       @default(1)
  services  Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("service_categories")
}

model Service {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  durationMinutes Int
  price           Decimal           @db.Decimal(10, 2)
  currency        SupportedCurrency @default(GHS)

  categoryId String?          @db.Uuid
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  maxBookingsPerDay Int?
  latestBookingTime String? // "HH:mm"
  minDepositPercent Int     @default(0)

  isActive  Boolean  @default(true)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings BookingService[]

  @@index([categoryId])
  @@map("services")
}

enum PaymentProvider {
  PRIMARY_PAYSTACK
  SECONDARY_PAYSTACK
  MANUAL
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  bookingId String  @db.Uuid
  booking   Booking @relation("BookingPayments", fields: [bookingId], references: [id], onDelete: Cascade)

  provider    PaymentProvider
  providerRef String // reference from gateway
  amount      Decimal           @db.Decimal(10, 2)
  currency    SupportedCurrency

  status     PaymentStatus
  rawPayload Json?
  reason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerRef])
  @@index([bookingId])
  @@map("payments")
}

model Booking {
  id               String @id @default(uuid()) @db.Uuid
  bookingReference String @unique
  clientName       String
  clientEmail      String
  clientPhone      String

  // serviceId String  @db.Uuid
  // service   Service @relation(fields: [serviceId], references: [id])
  services BookingService[]

  minDepositPercent Int?

  bookingDate String
  bookingTime String

  status        BookingStatus
  // paymentStatus PaymentStatus
  // paymentRef    String?
  paymentStatus PaymentStatus @default(PENDING)
  // payments      Payment[]
  googleEventId String?
  cancelReason  String?

  termsAcceptedAt DateTime?

  createdAt DateTime @default(now())

  createdById String? @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  payments          Payment[]          @relation("BookingPayments")
  invoices          Invoice[]          @relation("BookingInvoices")
  paymentAuditLogs  PaymentAuditLog[]  @relation("BookingPaymentAuditLogs")

  @@index([createdById])
  @@index([bookingDate])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

model BookingService {
  bookingId String @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId String @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id])

  priceAtBooking    Decimal @db.Decimal(10, 2)
  durationAtBooking Int

  @@id([bookingId, serviceId])
  @@map("booking_services")
}

model BusinessHour {
  id        String  @id @default(uuid()) @db.Uuid
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  startTime String
  endTime   String
  isOpen    Boolean @default(true)

  maxConcurrentBookings Int @default(4) //should be able to be set??phase 2??

  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
  @@map("business_hours")
}

model BlockedDate {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  reason    String?
  startTime DateTime? // Add this field
  endTime   DateTime? // Add this field
  createdAt DateTime @default(now())

  @@unique([date])
  @@map("blocked_dates")
}
enum InvoiceStatus {
  DRAFT
  PENDING
  ISSUED
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  bookingId     String        @db.Uuid
  booking       Booking       @relation("BookingInvoices", fields: [bookingId], references: [id], onDelete: Cascade)
  
  amount        Decimal       @db.Decimal(10, 2)
  currency      SupportedCurrency @default(GHS)
  status        InvoiceStatus @default(DRAFT)
  
  gateway       PaymentProvider?
  transactionType String      @default("initial") // e.g., "initial", "refund"
  
  dueDate       DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  
  parentInvoiceId String?    @db.Uuid
  parentInvoice   Invoice?   @relation("InvoiceChildren", fields: [parentInvoiceId], references: [id])
  childInvoices   Invoice[]  @relation("InvoiceChildren")

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  auditLogs     PaymentAuditLog[]

  @@index([bookingId])
  @@index([status])
  @@map("invoices")
}

model PaymentAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  invoiceId  String?  @db.Uuid
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  
  bookingId  String?  @db.Uuid
  booking    Booking? @relation("BookingPaymentAuditLogs", fields: [bookingId], references: [id])
  
  action     String // e.g., "INVOICE_CREATED", "PAYMENT_RECEIVED", "STATUS_UPDATED"
  oldValue   Json?
  newValue   Json?
  metadata   Json? // For tracking who did it, IP, etc.
  
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@map("payment_audit_logs")
}

model StyleImage {
  id         String   @id @default(uuid()) @db.Uuid
  url        String
  objectName String
  caption    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("style_images")
}

model SystemSetting {
  id    String @id @default(uuid()) @db.Uuid
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}