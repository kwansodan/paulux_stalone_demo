# Multi-stage build for Next.js application
FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
# Update CA certificates to fix TLS issues
RUN apk update && apk add --no-cache ca-certificates libc6-compat
WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./
# Copy prisma schema if it exists to generate client
COPY prisma ./prisma/

# Install dependencies including devDeps for build
RUN npm ci

# Install production dependencies only in a separate stage
FROM base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json* ./
# Copy prisma directory for postinstall script
COPY prisma ./prisma/

# Install only production dependencies
RUN npm ci --omit=dev

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build arguments for public environment variables
ARG NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY
ARG NEXT_PUBLIC_APP_URL

ENV NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=$NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_MINIO_ENDPOINT
ARG NEXT_PUBLIC_MINIO_PORT
ENV NEXT_PUBLIC_MINIO_ENDPOINT=$NEXT_PUBLIC_MINIO_ENDPOINT
ENV NEXT_PUBLIC_MINIO_PORT=$NEXT_PUBLIC_MINIO_PORT
ENV NEXT_TELEMETRY_DISABLED 1
# Fix for Turbopack TLS issues with Google Fonts
ENV NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS=1

# Generate Prisma client and build the application
RUN npx prisma generate
RUN NODE_OPTIONS="--max-old-space-size=4096" npm run build

# Production image, copy all the files and run next
FROM base AS runner
WORKDIR /app

ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder standalone output
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

# Create cache directory and set permissions
RUN mkdir -p .next/cache && chown -R nextjs:nodejs .next/cache

# Overwrite/Augment node_modules with full production dependencies to ensure seed scripts work
COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules

# Copy Prisma files for migrations
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder /app/generated ./generated
COPY --from=builder /app/package.json ./package.json

# Copy source files and config for seeding
COPY --from=builder /app/tsconfig.json ./tsconfig.json
COPY --from=builder /app/src ./src

# Install Prisma CLI for migrations (includes all WASM dependencies)
RUN npm install prisma@7.3.0 --save-dev --no-save

# Install tsx globally for running seed script
RUN npm install -g tsx

# Copy entrypoint script
COPY --chmod=755 docker-entrypoint.sh ./

# Change ownership of Prisma files and others to nextjs user
RUN chown -R nextjs:nodejs ./prisma ./generated ./src ./tsconfig.json ./node_modules 2>/dev/null || true

USER nextjs

EXPOSE 3000

ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["./docker-entrypoint.sh"]