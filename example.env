# ============================================
# DEMO DEPLOYMENT
# ============================================
# This stack is served directly on a host port over plain HTTP - there is no
# reverse proxy or TLS in front of it (see the `edge` profile note below).
# Substitute <VPS_IP> with the demo host's address; the real values live in the
# Komodo stack environment, not in this file.
#
#   NEXT_PUBLIC_APP_URL=http://<VPS_IP>:3002   <- build arg, rebuild to change
#   NEXT_PUBLIC_SITE_URL=http://<VPS_IP>:3002
#   NEXTAUTH_URL=http://<VPS_IP>:3002
#   BASE_URL=http://<VPS_IP>:3002
#   MINIO_PUBLIC_ENDPOINT=http://<VPS_IP>:9007
#   SECURE_COOKIES=false
#
# Open both ports on the host firewall or neither the app nor its images load:
#   sudo ufw allow 3002/tcp && sudo ufw allow 9007/tcp

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# For Docker: postgresql://DB_USER:DATABASE_PASSWORD@db:5432/polaris
# For local dev: postgresql://DB_USER:DATABASE_PASSWORD@localhost:5432/polaris
DATABASE_URL=postgresql://postgres:your_password@db:5432/polaris

# Direct (non-pooled) connection used by Prisma migrations. Same value as
# DATABASE_URL unless you put a connection pooler in front.
DIRECT_URL=postgresql://postgres:your_password@db:5432/polaris

# Database credentials
DATABASE_PASSWORD=your_secure_password_here
DB_USER=postgres

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here_generate_with_openssl

# Your application URL (must match NEXT_PUBLIC_APP_URL)
# Demo: http://<VPS_IP>:3002
# Development: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Server-side origin used to build callback and email links.
# Demo: http://<VPS_IP>:3002
BASE_URL=http://localhost:3000

# ============================================
# PAYSTACK PAYMENT GATEWAY
# ============================================
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Checkout is a server-side redirect flow, so this key is never read in the
# browser. It is a runtime var, NOT a build arg - changing it needs a restart
# only. See next_polaris/Dockerfile.prod.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Split-payment gateways. The booking flow defaults to PRIMARY, so without it
# checkout fails at the payment step.
PRIMARY_PAYSTACK_SECRET_KEY=sk_test_your_primary_paystack_secret_key
SECONDARY_PAYSTACK_SECRET_KEY=sk_test_your_secondary_paystack_secret_key

# ============================================
# HOST PORT MAPPING
# ============================================
# This demo stack is designed to run alongside the production Polaris stack on
# the same host, so it must not reuse production's published ports.
#   production: app 3000, db 5432, minio 9005/9001, nginx 80/443
#   dev:        app 3001,          minio 9006/9002
#   demo:       the defaults below
APP_HOST_PORT=3002
DB_HOST_PORT=5433
MINIO_HOST_PORT=9007
MINIO_CONSOLE_HOST_PORT=9003

# The database publishes to loopback only. Docker bypasses ufw, so binding a
# database to 0.0.0.0 exposes it to the internet no matter what the firewall
# says. Use an SSH tunnel for admin access (see DATABASE_ACCESS.md).
DB_BIND_HOST=127.0.0.1

# Only used with `--profile edge` (self-contained demo on its own host).
# HTTP_HOST_PORT=80
# HTTPS_HOST_PORT=443

# Session cookies. MUST be "false" when serving over plain HTTP, or the browser
# drops the session cookie and login silently fails. Set "true" behind TLS.
SECURE_COOKIES=false

# ============================================
# APPLICATION SETTINGS
# ============================================
# Public URL of your application
# Demo: http://<VPS_IP>:3002
# Development: http://localhost:3000
# NOTE: this one IS a build arg - changing it requires a rebuild, not a restart.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical origin for SEO metadata, sitemap and JSON-LD.
# Without this, src/lib/site-config.ts falls back to https://polarisbeautylounge.com,
# which would advertise the wrong domain on the demo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment (development, production, test)
NODE_ENV=development

# ============================================
# EMAIL SERVICE (Choose one)
# ============================================
# Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key

# Arkesel SMS (Optional)
ARKESEL_API_KEY=your_arkesel_api_key
ARKESAL_BASE_URL=https://sms.arkesel.com


# ============================================
# FILE STORAGE - MinIO (S3-Compatible)
# ============================================
# MinIO root credentials (admin user)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# MinIO connection settings
# For Docker: use service name 'minio'
# For local dev outside Docker: use 'localhost'
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# The app authenticates as this key pair (src/lib/minio.ts), but the MinIO
# server only knows MINIO_ROOT_USER / MINIO_ROOT_PASSWORD. These MUST match
# those two values, or every upload fails with AccessDenied.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
# Origin that uploaded files are served from, used to rewrite internal MinIO
# URLs into public ones (src/lib/minio.ts). MUST be set: it falls back to
# https://polarisbeautylounge.com/files, so leaving it blank makes this demo
# hotlink every image to a different deployment's live site.
# Demo: http://<VPS_IP>:9007
MINIO_PUBLIC_ENDPOINT=http://localhost:9007

# Public MinIO access (for client-side URLs)
# Must match MINIO_HOST_PORT above, or the public hostname/port your reverse
# proxy exposes MinIO on.
NEXT_PUBLIC_MINIO_ENDPOINT=localhost
NEXT_PUBLIC_MINIO_PORT=9007

# MinIO bucket name for storing files
MINIO_BUCKET_NAME=polaris-uploads

# MinIO Console UI redirect URL (optional) - must match MINIO_CONSOLE_HOST_PORT
MINIO_BROWSER_REDIRECT_URL=http://localhost:9003

# ============================================
# BACKGROUND JOBS (Inngest)
# ============================================
# Drives booking/payment notification events. INNGEST_DEV=1 runs against the
# local dev server and needs no keys - fine for a demo.
INNGEST_DEV=1
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ============================================
# GOOGLE CALENDAR SYNC (Optional)
# ============================================
# Leave blank to disable calendar sync.
GOOGLE_SERVICES_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# ============================================
# LOGGING & MONITORING (Optional but recommended)
# ============================================
# Sentry for error tracking
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# LogRocket for session replay
# LOGROCKET_APP_ID=your_app_id

# ============================================
# RATE LIMITING & SECURITY
# ============================================
# Rate limit per IP (requests per minute)
RATE_LIMIT_MAX=100

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# DEPLOYMENT (GitHub Actions Secrets)
# ============================================
# These should be set in GitHub repository secrets, not in .env
# SERVER_HOST=your_server_ip_or_domain
# SERVER_USERNAME=your_ssh_username
# SERVER_PORT=22
# SSH_PRIVATE_KEY=your_ssh_private_key
# DEPLOY_PATH=~/polaris
# DOCKERHUB_USERNAME=your_dockerhub_username (optional)
# DOCKERHUB_TOKEN=your_dockerhub_token (optional)